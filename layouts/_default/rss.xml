{{- /*
  覆盖主题 rss.xml：.Site.Author 在 Hugo 0.146 起已移除，会导致新版本构建直接失败。
  改读 params.author / params.authorEmail，同时补上 description（原模板输出的是英文
  "Recent content on ..."）。
*/ -}}
{{- $pctx := . -}}
{{- if .IsHome -}}{{ $pctx = .Site }}{{- end -}}
{{- $pages := slice -}}
{{- if or $.IsHome $.IsSection -}}
{{- $pages = (where (where $pctx.RegularPages ".Section" "posts") "Kind" "page") -}}
{{- else -}}
{{- $pages = (where (where $pctx.Pages ".Section" "posts") "Kind" "page") -}}
{{- end -}}
{{- $limit := .Site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}
{{- $pages = $pages | first $limit -}}
{{- end -}}
{{- $author := or site.Params.author site.Title -}}
{{- $email := site.Params.authorEmail -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if eq .Title .Site.Title }}{{ .Site.Title }}{{ else }}{{ with .Title }}{{ . }} - {{ end }}{{ .Site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ with site.Params.description }}{{ . }}{{ else }}{{ .Site.Title }}{{ end }}</description>
    <generator>Hugo -- gohugo.io</generator>
    <language>{{ or site.Language.LanguageCode site.LanguageCode "zh-cn" }}</language>
    {{- with $email }}
    <managingEditor>{{ . }} ({{ $author }})</managingEditor>
    <webMaster>{{ . }} ({{ $author }})</webMaster>
    {{- end }}
    {{- with .Site.Copyright }}
    <copyright>{{ . }}</copyright>
    {{- end }}
    {{- if not .Date.IsZero }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{ range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{- with $email }}
      <author>{{ . }} ({{ $author }})</author>
      {{- end }}
      <guid>{{ .Permalink }}</guid>
      <description>{{ .Content | html }}</description>
    </item>
    {{ end }}
  </channel>
</rss>
